+    def _get_best_implementation_fallback(self, stage_name: str) -> Optional[Node]:
+        """Time version. The cumulative main-stage deadline can end the LAST sub-stage of a
+        main stage after only a few nodes, all buggy. Factory AIS then finds no best implementation in that
+        sub-stage's journal and aborts the whole experiment ('Something went wrong so finishing the experiment').
+        Under its own iteration quotas this cannot happen, because every sub-stage runs to its own completion
+        (LLM-judged complete, which implies a working node, or its full quota). Restore that assumption: when the
+        named sub-stage has no working node, take the best implementation of the latest earlier sub-stage of the
+        same main stage that has one. The search logic itself is untouched."""
+        best = self._get_best_implementation(stage_name)
+        if best is not None:
+            return best
+        try:
+            main = self.parse_stage_names(stage_name)[0]
+        except Exception:
+            return None
+        prefix = f"{main}_"
+        earlier = [s.name for s in self.stages if s.name.startswith(prefix) and s.name != stage_name]
+        for name in reversed(earlier):
+            cand = self._get_best_implementation(name)
+            if cand is not None:
+                msg = (f"time version: {stage_name} ended at the stage deadline without a working node; "
+                       f"using the best implementation of {name} instead")
+                logger.warning(msg)
+                print(f"[yellow]{msg}[/yellow]")
+                return cand
