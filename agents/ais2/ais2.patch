+    def _compute_stage_deadlines(self, from_stage: int = 1, now: Optional[float] = None) -> Dict[int, float]:
+        """Deadline per MAIN stage. The time still left in the
+        run budget is split among the stages that have not started yet, in proportion to the
+        factory iteration quotas (20/12/12/18 -> 12:12:18 after stage 1, 12:18 after stage 2, ...).
+        Called at run start (from_stage=1) and again whenever a main stage starts, so a stage that
+        ends early hands its unused time to ALL later stages by quota, not just to the next one.
+        The last stage's deadline is always the run budget; a stage that overruns its deadline
+        (by at most one step) shrinks the later stages accordingly."""
+        stages_cfg = getattr(self.cfg.agent, "stages", None)
+        budget_min = getattr(stages_cfg, "time_budget_min", None) if stages_cfg is not None else None
+        if not budget_min:
+            return {}
+        quota = list(getattr(stages_cfg, "time_quota", None) or [20, 12, 12, 18])
+        if self._run_end is None:
+            self._run_end = self._run_t0 + float(budget_min) * 60.0
+        now = self._run_t0 if now is None else now
+        remaining = max(self._run_end - now, 0.0)
+        rest = quota[from_stage - 1:]
+        total = float(sum(rest)) or 1.0
+        deadlines: Dict[int, float] = {}
+        acc = 0.0
+        for k, q in enumerate(rest, start=from_stage):
+            acc += float(q)
+            deadlines[k] = now + remaining * acc / total
+        deadlines[len(quota)] = self._run_end
+        print("[cyan]Stage time budget: %s min total; deadlines recomputed at stage %d start (min from run start): %s[/cyan]" % (
+            budget_min, from_stage, ", ".join("stage %d: %.0f" % (k, (d - self._run_t0) / 60.0) for k, d in deadlines.items())))
+        return deadlines
+
+    def _stage_time_exhausted(self, main_stage_num: int) -> bool:
+        dl = self._stage_deadlines.get(main_stage_num)
+        return dl is not None and time.time() >= dl
+
+    def _stage_time_fraction(self, main_stage_num: int) -> float:
+        """Elapsed fraction of this main stage's own time window (0 when deadlines are off)."""
+        dl = self._stage_deadlines.get(main_stage_num)
+        if dl is None:
+            return 0.0
+        start = self._stage_started.get(main_stage_num, self._run_t0)
+        return (time.time() - start) / max(dl - start, 1.0)
+
